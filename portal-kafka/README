docker compose up -d -- odpalenie kafka + zookeper w kontenerach
docker build -t portal-kafka:latest . --budowanie obrazu aplikacji
kubectl apply -f k8s-deployment.yaml -- odpalenie aplikacji w kubernetes
kubectl port-forward deployment/portal-kafka-app 8080:8080 -- przekierowanie portu z kontenera na lokalny port

kubectl rollout restart deployment portal-kafka-app -- restart aplikacji w kubernetes
kubectl get pods -w -- podgląd podów
kubectl get hpa -- podgląd hpa (--watch)